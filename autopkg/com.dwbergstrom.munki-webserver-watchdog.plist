<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dwbergstrom.munki-webserver-watchdog</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/dwbergstrom/github/munki_files/autopkg/munki-webserver-watchdog.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/tmp</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/munki:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>

	<!-- Health-check every 5 minutes; script is silent when healthy -->
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>/Users/dwbergstrom/Library/Logs/munki-webserver-watchdog.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/dwbergstrom/Library/Logs/munki-webserver-watchdog.err</string>
</dict>
</plist>
