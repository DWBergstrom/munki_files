<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dwbergstrom.munki-webserver</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/dwbergstrom/github/munki_files/autopkg/munki-webserver.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/tmp</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/munki:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>

	<!-- Start at login / after reboot; restart if the process exits -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<!-- Avoid tight restart loops if the volume is missing -->
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>/Users/dwbergstrom/Library/Logs/munki-webserver.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/dwbergstrom/Library/Logs/munki-webserver.err</string>
</dict>
</plist>
